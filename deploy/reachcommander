#!/usr/bin/env bash
set -Eeuo pipefail

umask 077

SCRIPT_DIRECTORY="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
if [[ "${REACHCOMMANDER_TESTING:-0}" == '1' ]] && (( EUID != 0 )); then
  COMMON_LIBRARY="$SCRIPT_DIRECTORY/lib/common.sh"
else
  COMMON_LIBRARY='/opt/reachcommander/lib/common.sh'
fi

if [[ ! -f "$COMMON_LIBRARY" ]]; then
  printf 'ReachCommander: management library is missing\n' >&2
  exit 1
fi

# shellcheck source=lib/common.sh
source "$COMMON_LIBRARY"

init_updater_paths() {
  RC_UPDATER_UNIT_PATH='/etc/systemd/system/reachcommander-updater.service'
  RC_UPDATER_RUNTIME_DIRECTORY='/run/reachcommander-updater'
  RC_UPDATER_SOCKET_PATH="$RC_UPDATER_RUNTIME_DIRECTORY/updater.sock"
  if [[ "${REACHCOMMANDER_TESTING:-0}" == '1' ]] && (( EUID != 0 )); then
    RC_UPDATER_UNIT_PATH="${REACHCOMMANDER_TEST_SYSTEMD_UNIT_PATH:-}"
    RC_UPDATER_RUNTIME_DIRECTORY="${REACHCOMMANDER_TEST_UPDATER_RUNTIME_DIRECTORY:-}"
    RC_UPDATER_SOCKET_PATH="${REACHCOMMANDER_TEST_UPDATER_SOCKET_PATH:-}"
    if [[ -z "$RC_UPDATER_UNIT_PATH" || -z "$RC_UPDATER_RUNTIME_DIRECTORY" || -z "$RC_UPDATER_SOCKET_PATH" ]]; then
      rc_die 'all updater test paths are required'
      return 1
    fi
  fi
  export RC_UPDATER_UNIT_PATH RC_UPDATER_RUNTIME_DIRECTORY RC_UPDATER_SOCKET_PATH
}

usage() {
  cat >&2 <<'EOF'
Usage:
  reachcommander status
  reachcommander logs [--follow]
  reachcommander update-log [--follow]
  reachcommander support-bundle
  reachcommander start
  reachcommander stop
  reachcommander restart
  reachcommander doctor
  reachcommander source add
  reachcommander update [stable|edge|vX.Y.Z]
  reachcommander uninstall
EOF
  return 64
}

validate_invocation() {
  local command_name="${1:-}"
  local argument_count="$#"
  case "$command_name" in
    status | start | stop | restart | doctor | support-bundle | uninstall)
      (( argument_count == 1 )) || return 64
      ;;
    logs)
      if (( argument_count == 1 )); then
        return 0
      fi
      (( argument_count == 2 )) && [[ "${2:-}" == '--follow' ]] || return 64
      ;;
    update-log)
      if (( argument_count == 1 )); then
        return 0
      fi
      (( argument_count == 2 )) && [[ "${2:-}" == '--follow' ]] || return 64
      ;;
    update)
      (( argument_count == 1 || argument_count == 2 )) || return 64
      ;;
    source)
      (( argument_count == 2 )) && [[ "${2:-}" == 'add' ]] || return 64
      ;;
    *)
      return 64
      ;;
  esac
}

if ! validate_invocation "$@"; then
  usage
  exit 64
fi

rc_init_paths
init_updater_paths
rc_assert_safe_install_root
if [[ "${REACHCOMMANDER_TESTING:-0}" != '1' ]] || (( EUID == 0 )); then
  rc_require_root
fi

read_state_line() {
  local path="$1"
  local value
  [[ -f "$path" ]] || {
    rc_die 'deployment state is incomplete'
    return 1
  }
  IFS= read -r value <"$path" || [[ -n "$value" ]] || {
    rc_die 'deployment state is empty'
    return 1
  }
  printf '%s\n' "$value"
}

command_status() {
  local channel
  local image
  local version
  channel="$(read_state_line "$RC_INSTALL_ROOT/state/channel")"
  image="$(read_state_line "$RC_INSTALL_ROOT/state/current-image")"
  version="$(read_state_line "$RC_INSTALL_ROOT/state/current-version")"
  printf 'Channel: %s\n' "$channel"
  printf 'Version: %s\n' "$version"
  printf 'Image: %s\n' "$image"
  rc_compose ps
}

command_logs() {
  if [[ "${1:-}" == '--follow' ]]; then
    rc_compose logs --tail 200 --follow reachcommander
  else
    rc_compose logs --tail 200 reachcommander
  fi
}

run_update_trace_cli() {
  local test_trace_root
  if [[ "${REACHCOMMANDER_TESTING:-0}" == '1' ]] && ((EUID != 0)); then
    test_trace_root="$RC_INSTALL_ROOT/state/update-traces"
    if command -v cygpath >/dev/null 2>&1; then
      test_trace_root="$(cygpath -w -- "$test_trace_root")"
    fi
    REACHCOMMANDER_TEST_TRACE_ROOT="$test_trace_root" \
      PYTHONDONTWRITEBYTECODE=1 \
      python3 "$RC_INSTALL_ROOT/bin/update_trace_cli.py" "$@"
    return
  fi
  PYTHONDONTWRITEBYTECODE=1 \
    python3 "$RC_INSTALL_ROOT/bin/update_trace_cli.py" "$@"
}

command_update_log() {
  if [[ -n "${1:-}" ]]; then
    run_update_trace_cli "$1"
  else
    run_update_trace_cli
  fi
}

command_support_bundle() {
  local support_bundle_cli="$RC_INSTALL_ROOT/bin/support_bundle_cli.py"
  [[ -f "$support_bundle_cli" && ! -L "$support_bundle_cli" ]] || {
    rc_die 'support-bundle helper is unavailable'
    return 1
  }
  PYTHONDONTWRITEBYTECODE=1 python3 "$support_bundle_cli"
}

source_management_dependencies_are_safe() {
  local specification
  local relative_path
  local expected_mode
  local installed_path
  local owner
  local mode
  local source_directories=(
    '.:700'
    'bin:700'
    'lib:700'
  )
  local source_dependencies=(
    'bin/source_management.py:755'
    'bin/render_config.py:755'
    'lib/updater_protocol.py:644'
    'lib/compose.release.yaml:600'
  )
  for specification in "${source_directories[@]}"; do
    IFS=: read -r relative_path expected_mode <<<"$specification"
    installed_path="$RC_INSTALL_ROOT/$relative_path"
    if [[ ! -d "$installed_path" || -L "$installed_path" ]]; then
      return 1
    fi
    if [[ "${REACHCOMMANDER_TESTING:-0}" != '1' ]]; then
      owner="$(stat -c '%u:%g' -- "$installed_path" 2>/dev/null || true)"
      mode="$(stat -c '%a' -- "$installed_path" 2>/dev/null || true)"
      if [[ "$owner" != '0:0' || "$mode" != "$expected_mode" ]]; then
        return 1
      fi
    fi
  done
  for specification in "${source_dependencies[@]}"; do
    IFS=: read -r relative_path expected_mode <<<"$specification"
    installed_path="$RC_INSTALL_ROOT/$relative_path"
    if [[ ! -f "$installed_path" || -L "$installed_path" ]]; then
      return 1
    fi
    if [[ "${REACHCOMMANDER_TESTING:-0}" != '1' ]]; then
      owner="$(stat -c '%u:%g' -- "$installed_path" 2>/dev/null || true)"
      mode="$(stat -c '%a' -- "$installed_path" 2>/dev/null || true)"
      if [[ "$owner" != '0:0' || "$mode" != "$expected_mode" ]]; then
        return 1
      fi
    fi
  done
}

SOURCE_ADD_CAPTURE=''
SOURCE_ADD_DRAIN_PID=''
SOURCE_ADD_HELPER_PID=''
SOURCE_ADD_HELPER_PGID=''
SOURCE_ADD_WRITER_OPEN=0

source_add_pid_stopped() {
  local pid="$1"
  local process_state=''
  if [[ -r "/proc/$pid/stat" ]]; then
    IFS= read -r process_state <"/proc/$pid/stat" || return 1
    process_state="${process_state##*) }"
    [[ "${process_state:0:1}" == 'Z' || "${process_state:0:1}" == 'X' ]]
    return
  fi
  ! kill -0 "$pid" 2>/dev/null
}

source_add_wait_pid_stopped() {
  local pid="$1"
  local attempts="$2"
  local attempt
  for ((attempt = 0; attempt < attempts; attempt += 1)); do
    if source_add_pid_stopped "$pid"; then
      return 0
    fi
    sleep 0.05
  done
  source_add_pid_stopped "$pid"
}

source_add_wait_group_stopped() {
  local group_id="$1"
  local attempts="$2"
  local attempt
  for ((attempt = 0; attempt < attempts; attempt += 1)); do
    if ! kill -0 -- "-$group_id" 2>/dev/null; then
      return 0
    fi
    sleep 0.05
  done
  ! kill -0 -- "-$group_id" 2>/dev/null
}

stop_source_add_processes() {
  local drain_pid="$SOURCE_ADD_DRAIN_PID"
  local helper_pid="$SOURCE_ADD_HELPER_PID"
  local helper_pgid="$SOURCE_ADD_HELPER_PGID"
  local writer_open="$SOURCE_ADD_WRITER_OPEN"
  SOURCE_ADD_DRAIN_PID=''
  SOURCE_ADD_HELPER_PID=''
  SOURCE_ADD_HELPER_PGID=''
  SOURCE_ADD_WRITER_OPEN=0

  if [[ "$helper_pgid" =~ ^[1-9][0-9]*$ ]]; then
    kill -TERM -- "-$helper_pgid" 2>/dev/null || true
  fi
  if (( writer_open == 1 )); then
    exec 8>&- 2>/dev/null || true
  fi
  if [[ "$helper_pgid" =~ ^[1-9][0-9]*$ ]] &&
    ! source_add_wait_group_stopped "$helper_pgid" 3; then
    kill -KILL -- "-$helper_pgid" 2>/dev/null || true
    source_add_wait_group_stopped "$helper_pgid" 5 || true
  fi

  if [[ "$drain_pid" =~ ^[1-9][0-9]*$ ]] &&
    ! source_add_wait_pid_stopped "$drain_pid" 20; then
    kill -TERM -- "-$drain_pid" 2>/dev/null || true
    if ! source_add_wait_pid_stopped "$drain_pid" 3; then
      kill -KILL -- "-$drain_pid" 2>/dev/null || true
      source_add_wait_pid_stopped "$drain_pid" 5 || true
    fi
  fi

  if [[ "$helper_pid" =~ ^[1-9][0-9]*$ ]] && source_add_pid_stopped "$helper_pid"; then
    wait "$helper_pid" 2>/dev/null || true
  fi
  if [[ "$drain_pid" =~ ^[1-9][0-9]*$ ]] && source_add_pid_stopped "$drain_pid"; then
    wait "$drain_pid" 2>/dev/null || true
  fi
}

cleanup_source_add_capture() {
  local candidate="$SOURCE_ADD_CAPTURE"
  SOURCE_ADD_CAPTURE=''
  stop_source_add_processes
  if [[ -z "$candidate" ]]; then
    for candidate in "$RC_INSTALL_ROOT"/.source-add-stdout.??????; do
      case "$candidate" in
        "$RC_INSTALL_ROOT"/.source-add-stdout.[A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9])
          if [[ -f "$candidate" && ! -L "$candidate" ]]; then
            rm -f -- "$candidate" || true
          fi
          ;;
      esac
    done
    return
  fi
  case "$candidate" in
    "$RC_INSTALL_ROOT"/.source-add-stdout.[A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9])
      if [[ -f "$candidate" && ! -L "$candidate" ]]; then
        rm -f -- "$candidate" || true
      fi
      ;;
  esac
}

finish_source_add_capture() {
  cleanup_source_add_capture
  trap - EXIT INT TERM
}

validate_source_add_success() {
  PYTHONDONTWRITEBYTECODE=1 python3 -c '
import json
import re
import sys
from pathlib import Path

def unique_object(pairs):
    value = {}
    for key, item in pairs:
        if key in value:
            raise ValueError("duplicate key")
        value[key] = item
    return value

raw = Path(sys.argv[1]).read_bytes()
value = json.loads(raw.decode("utf-8"), object_pairs_hook=unique_object)
if type(value) is not dict or set(value) != {"sourceId", "displayName"}:
    raise ValueError("invalid shape")
source_id = value["sourceId"]
display_name = value["displayName"]
if type(source_id) is not str or re.fullmatch(r"[a-z][a-z0-9-]{0,62}", source_id) is None:
    raise ValueError("invalid source ID")
if (
    type(display_name) is not str
    or not 1 <= len(display_name) <= 80
    or display_name != display_name.strip()
    or any(not character.isprintable() for character in display_name)
):
    raise ValueError("invalid display name")
sys.stdout.buffer.write(
    json.dumps(
        {"sourceId": source_id, "displayName": display_name},
        ensure_ascii=False,
        separators=(",", ":"),
    ).encode("utf-8")
)
' "$1" 2>/dev/null
}

command_source_add() {
  local source_helper="$RC_INSTALL_ROOT/bin/source_management.py"
  local source_stdout=''
  local source_capture_pid=''
  local source_status=1
  local output_size=0
  local emit_status=0
  local validated_output=''
  rc_acquire_lock || return 1
  if ! source_management_dependencies_are_safe; then
    rc_die 'source-management helper is unavailable or unsafe'
    return 1
  fi
  SOURCE_ADD_CAPTURE=''
  trap cleanup_source_add_capture EXIT
  trap 'cleanup_source_add_capture; exit 130' INT
  trap 'cleanup_source_add_capture; exit 143' TERM
  source_stdout="$(mktemp "$RC_INSTALL_ROOT/.source-add-stdout.XXXXXX")" || {
    finish_source_add_capture
    printf '%s\n' '{"code":"source_management_failed","detail":"The source-management operation could not be completed."}'
    return 1
  }
  SOURCE_ADD_CAPTURE="$source_stdout"
  if ! chmod 0600 -- "$source_stdout"; then
    finish_source_add_capture
    printf '%s\n' '{"code":"source_management_failed","detail":"The source-management operation could not be completed."}'
    return 1
  fi
  SOURCE_ADD_WRITER_OPEN=1
  exec 8> >(
    REACHCOMMANDER_SOURCE_DRAIN=1 exec setsid python3 -c '
import os
import sys

capture_fd = os.open(sys.argv[1], os.O_WRONLY | os.O_TRUNC)
remaining = 4097
try:
    while True:
        chunk = os.read(0, 65536)
        if not chunk:
            break
        if remaining:
            captured = chunk[:remaining]
            while captured:
                written = os.write(capture_fd, captured)
                captured = captured[written:]
            remaining -= min(remaining, len(chunk))
finally:
    os.close(capture_fd)
' "$source_stdout" 2>/dev/null
  )
  source_capture_pid=$!
  SOURCE_ADD_DRAIN_PID="$source_capture_pid"
  PYTHONDONTWRITEBYTECODE=1 setsid python3 "$source_helper" >&8 2>/dev/null &
  SOURCE_ADD_HELPER_PID=$!
  SOURCE_ADD_HELPER_PGID="$SOURCE_ADD_HELPER_PID"
  if wait "$SOURCE_ADD_HELPER_PID"; then
    source_status=0
  else
    source_status=$?
  fi
  SOURCE_ADD_HELPER_PID=''
  stop_source_add_processes
  output_size="$(wc -c <"$source_stdout")"
  if (( source_status == 0 && output_size > 0 && output_size <= 4096 )); then
    if validated_output="$(validate_source_add_success "$source_stdout")" &&
      (( ${#validated_output} > 0 && ${#validated_output} <= 4096 )); then
      printf '%s\n' "$validated_output" || emit_status=$?
      finish_source_add_capture
      return "$emit_status"
    fi
    source_status=1
  fi
  finish_source_add_capture
  case "$source_status" in
    2)
      printf '%s\n' '{"code":"invalid_request","detail":"The source-management request is invalid."}'
      return 2
      ;;
    3)
      printf '%s\n' '{"code":"validation_failed","detail":"The source folder could not be accepted."}'
      return 3
      ;;
    4)
      printf '%s\n' '{"code":"busy","detail":"Another ReachCommander operation is already running."}'
      return 4
      ;;
    5)
      printf '%s\n' '{"code":"rolled_back","detail":"The source change was rolled back."}'
      return 5
      ;;
    6)
      printf '%s\n' '{"code":"recovery_failed","detail":"The source change requires manual recovery."}'
      return 6
      ;;
    7)
      printf '%s\n' '{"code":"untrusted_source_ancestry","detail":"The source folder'"'"'s parent directories must be root-owned and not group- or world-writable."}'
      return 7
      ;;
    *)
      printf '%s\n' '{"code":"source_management_failed","detail":"The source-management operation could not be completed."}'
      return 1
      ;;
  esac
}

command_start() {
  rc_acquire_lock
  rc_compose up -d reachcommander
  rc_wait_healthy reachcommander 60
}

command_stop() {
  rc_acquire_lock
  rc_compose stop reachcommander
}

command_restart() {
  rc_acquire_lock
  rc_compose restart reachcommander
  rc_wait_healthy reachcommander 60
}

trusted_image_digest() {
  [[ "${1:-}" =~ ^ghcr\.io/dragosniamtu/reach-commander@sha256:[0-9a-f]{64}$ ]]
}

atomic_copy_file() {
  local source="$1"
  local destination="$2"
  local mode="${3:-0600}"
  local destination_directory
  local temporary
  destination_directory="$(dirname -- "$destination")"
  mkdir -p -- "$destination_directory"
  temporary="$(mktemp "$destination_directory/.reachcommander-copy.XXXXXX")"
  if ! install -m "$mode" -- "$source" "$temporary" || ! sync -f -- "$temporary"; then
    rm -f -- "$temporary"
    rc_die 'failed to stage deployment state'
    return 1
  fi
  if ! mv -f -- "$temporary" "$destination"; then
    rm -f -- "$temporary"
    rc_die 'failed to replace deployment state'
    return 1
  fi
}

UPDATE_BACKUP_FILES=(
  '.env'
  'config/sources.json'
  'state/source-mounts.json'
  'state/channel'
  'state/current-image'
  'state/previous-image'
  'state/current-version'
  'state/previous-version'
)

create_update_backup() {
  local backup_root="$RC_INSTALL_ROOT/backups"
  local backup_directory
  local relative_path
  if [[ -L "$backup_root" ]]; then
    rc_die 'update backup directory must not be a symlink'
    return 1
  fi
  mkdir -p -- "$backup_root"
  chmod 0700 -- "$backup_root"
  backup_directory="$(mktemp -d "$backup_root/.update.XXXXXX")"
  for relative_path in "${UPDATE_BACKUP_FILES[@]}"; do
    if [[ ! -f "$RC_INSTALL_ROOT/$relative_path" || -L "$RC_INSTALL_ROOT/$relative_path" ]]; then
      rc_die 'deployment state cannot be backed up safely'
      return 1
    fi
    mkdir -p -- "$backup_directory/$(dirname -- "$relative_path")"
    install -m 0600 -- \
      "$RC_INSTALL_ROOT/$relative_path" \
      "$backup_directory/$relative_path"
  done
  printf '%s\n' "$backup_directory"
}

restore_update_backup() {
  local backup_directory="$1"
  local relative_path
  for relative_path in "${UPDATE_BACKUP_FILES[@]}"; do
    if [[ "$relative_path" == 'config/sources.json' ]]; then
      atomic_copy_file \
        "$backup_directory/$relative_path" \
        "$RC_INSTALL_ROOT/$relative_path" \
        0644 || return 1
    else
      atomic_copy_file \
        "$backup_directory/$relative_path" \
        "$RC_INSTALL_ROOT/$relative_path" || return 1
    fi
  done
  chmod 0755 -- "$RC_INSTALL_ROOT/config"
}

remove_update_backup() {
  local backup_directory="$1"
  local canonical_backup_root
  local canonical_backup
  local relative_path
  canonical_backup_root="$(readlink -m -- "$RC_INSTALL_ROOT/backups")"
  canonical_backup="$(readlink -m -- "$backup_directory")"
  case "$canonical_backup" in
    "$canonical_backup_root"/.update.*)
      ;;
    *)
      rc_die 'refusing to remove an unexpected update backup'
      return 1
      ;;
  esac
  if [[ -L "$backup_directory" ]]; then
    rc_die 'refusing to follow an update backup symlink'
    return 1
  fi
  for relative_path in "${UPDATE_BACKUP_FILES[@]}"; do
    rm -f -- "$backup_directory/$relative_path"
  done
  rmdir -- \
    "$backup_directory/config" \
    "$backup_directory/state" \
    "$backup_directory"
}

maybe_interrupt_update() {
  local phase="$1"
  if [[
    "${REACHCOMMANDER_TESTING:-0}" == '1' &&
    "${REACHCOMMANDER_TEST_INTERRUPT_AFTER:-}" == "$phase"
  ]] && (( EUID != 0 )); then
    kill -TERM "$$"
  fi
}

verify_update_state() {
  local channel
  local current_image
  local environment_image
  local previous_image=''
  local current_version
  local previous_version=''
  if [[ -e "$RC_INSTALL_ROOT/backups/.source-transaction" || -L "$RC_INSTALL_ROOT/backups/.source-transaction" ]]; then
    rc_die 'an incomplete source transaction must be recovered before updating'
    return 1
  fi
  if [[ -e "$RC_INSTALL_ROOT/state/update-transaction" ]]; then
    printf 'ReachCommander: an incomplete update transaction exists; run reachcommander doctor before retrying.\n' >&2
    return 1
  fi
  if ! channel="$(read_state_line "$RC_INSTALL_ROOT/state/channel")" ||
    ! rc_validate_channel "$channel" >/dev/null 2>&1; then
    rc_die 'saved update channel is invalid'
    return 1
  fi
  if ! current_image="$(read_state_line "$RC_INSTALL_ROOT/state/current-image")" ||
    ! trusted_image_digest "$current_image"; then
    rc_die 'current image state is not a trusted digest'
    return 1
  fi
  if ! environment_image="$(read_env_value REACHCOMMANDER_IMAGE)" ||
    [[ "$environment_image" != "$current_image" ]]; then
    rc_die 'environment image and current-image state are inconsistent; run reachcommander doctor'
    return 1
  fi
  if [[ -s "$RC_INSTALL_ROOT/state/previous-image" ]]; then
    previous_image="$(read_state_line "$RC_INSTALL_ROOT/state/previous-image")"
    if ! trusted_image_digest "$previous_image"; then
      rc_die 'previous image state is not a trusted digest'
      return 1
    fi
  fi
  if ! current_version="$(read_state_line "$RC_INSTALL_ROOT/state/current-version")" ||
    ! rc_validate_display_version "$current_version" >/dev/null 2>&1; then
    rc_die 'current display version state is invalid'
    return 1
  fi
  if [[ -s "$RC_INSTALL_ROOT/state/previous-version" ]]; then
    previous_version="$(read_state_line "$RC_INSTALL_ROOT/state/previous-version")"
    if ! rc_validate_display_version "$previous_version" >/dev/null 2>&1; then
      rc_die 'previous display version state is invalid'
      return 1
    fi
  fi
  if [[ -n "$previous_image" && -z "$previous_version" || -z "$previous_image" && -n "$previous_version" ]]; then
    rc_die 'previous image and display version state are inconsistent'
    return 1
  fi
}

report_update_stage() {
  local stage="${1:-}"
  case "$stage" in
    downloading | installing | restarting | healthChecking | \
      restoring | restartingPrevious | verifyingRecovery)
      printf 'REACHCOMMANDER_UPDATE_STAGE=%s\n' "$stage" >&2
      ;;
    *)
      rc_die 'internal update progress stage is invalid'
      return 1
      ;;
  esac
}

report_update_event() {
  local code="${1:-}"
  local outcome="${2:-}"
  case "$code:$outcome" in
    downloadStarted:started | downloadCompleted:succeeded | \
      backupStarted:started | backupCompleted:succeeded | \
      installStarted:started | installCompleted:succeeded | \
      candidateRestartStarted:started | candidateRestartCompleted:succeeded | \
      candidateRestartCompleted:failed | candidateImageVerified:succeeded | \
      candidateImageVerified:failed | candidateHealthStarted:started | \
      candidateHealthActivity:activity | candidateHealthSucceeded:succeeded | \
      candidateHealthFailed:failed | rollbackStarted:started | \
      rollbackStateRestored:succeeded | rollbackStateRestored:failed | \
      previousRestartStarted:started | previousRestartCompleted:succeeded | \
      previousRestartCompleted:failed | previousImageVerified:succeeded | \
      previousImageVerified:failed | recoveryHealthStarted:started | \
      recoveryHealthActivity:activity | recoveryHealthSucceeded:succeeded | \
      recoveryHealthFailed:failed)
      printf 'REACHCOMMANDER_UPDATE_EVENT=%s:%s\n' "$code" "$outcome" >&2
      ;;
    *)
      rc_die 'internal update trace event is invalid'
      return 1
      ;;
  esac
}

verify_running_image() {
  local expected_image="${1:-}"
  local expected_id
  local running_id
  if ! expected_id="$(
    docker image inspect --format '{{.Id}}' "$expected_image"
  )"; then
    rc_die 'expected container image identity could not be inspected'
    return 1
  fi
  if ! running_id="$(
    docker inspect --format '{{.Image}}' reachcommander
  )"; then
    rc_die 'running container image identity could not be inspected'
    return 1
  fi
  if [[ ! "$expected_id" =~ ^sha256:[0-9a-f]{64}$ || "$running_id" != "$expected_id" ]]; then
    rc_die 'running container image does not match the expected update image'
    return 1
  fi
}

wait_for_update_health() {
  local container="${1:-}"
  local timeout="${2:-}"
  local activity_event="${3:-}"
  local deadline
  local status
  local attempts=0
  if [[ -z "$container" || ! "$timeout" =~ ^[1-9][0-9]*$ ]]; then
    rc_die 'health check requires a container and positive timeout'
    return 1
  fi
  case "$activity_event" in
    candidateHealthActivity | recoveryHealthActivity) ;;
    *)
      rc_die 'internal update health activity event is invalid'
      return 1
      ;;
  esac
  deadline=$((SECONDS + timeout))
  while ((SECONDS <= deadline)); do
    if ! status="$(
      docker inspect \
        --format '{{if .State.Health}}{{.State.Health.Status}}{{else}}missing{{end}}' \
        "$container"
    )"; then
      rc_die 'container health inspection failed'
      return 1
    fi
    case "$status" in
      healthy)
        return 0
        ;;
      unhealthy | missing)
        rc_die 'container is not healthy'
        return 1
        ;;
      starting | created | restarting)
        attempts=$((attempts + 1))
        if (((attempts - 1) % 15 == 0)); then
          report_update_event "$activity_event" activity
        fi
        ;;
      *)
        rc_die 'container returned an invalid health status'
        return 1
        ;;
    esac
    if [[ "${REACHCOMMANDER_TESTING:-0}" != '1' ]]; then
      sleep 1
    fi
  done
  rc_die 'container health check timed out'
  return 1
}

command_update() {
  local requested_channel="${1:-}"
  local saved_channel
  local current_image
  local current_version
  local resolved_image
  local resolved_version
  local backup_directory
  local marker="$RC_INSTALL_ROOT/state/update-transaction"

  if ! rc_acquire_lock; then
    return 1
  fi
  if ! verify_update_state; then
    return 1
  fi
  saved_channel="$(read_state_line "$RC_INSTALL_ROOT/state/channel")"
  current_image="$(read_state_line "$RC_INSTALL_ROOT/state/current-image")"
  current_version="$(read_state_line "$RC_INSTALL_ROOT/state/current-version")"
  requested_channel="${requested_channel:-$saved_channel}"
  if ! rc_validate_channel "$requested_channel" >/dev/null 2>&1; then
    rc_die 'requested update channel is invalid'
    return 1
  fi
  report_update_stage downloading
  report_update_event downloadStarted started
  if ! resolved_image="$(rc_pull_digest "$requested_channel")"; then
    return 1
  fi
  report_update_event downloadCompleted succeeded
  if [[ "$resolved_image" == "$current_image" ]]; then
    printf 'ReachCommander is already running %s.\n' "$resolved_image"
    return 0
  fi
  if ! resolved_version="$(rc_image_display_version "$resolved_image" "$requested_channel")"; then
    return 1
  fi

  report_update_stage installing
  report_update_event backupStarted started
  if ! backup_directory="$(create_update_backup)"; then
    return 1
  fi
  report_update_event backupCompleted succeeded
  report_update_event installStarted started
  rc_atomic_write "$marker" "$backup_directory"$'\n'
  rc_atomic_write "$RC_INSTALL_ROOT/state/previous-image" "$current_image"$'\n'
  rc_atomic_write "$RC_INSTALL_ROOT/state/previous-version" "$current_version"$'\n'
  maybe_interrupt_update previous-version
  python3 "$RC_INSTALL_ROOT/bin/render_config.py" set-image \
    --env "$RC_INSTALL_ROOT/.env" \
    --image "$resolved_image"
  maybe_interrupt_update environment
  rc_atomic_write "$RC_INSTALL_ROOT/state/current-image" "$resolved_image"$'\n'
  maybe_interrupt_update current-image
  rc_atomic_write "$RC_INSTALL_ROOT/state/current-version" "$resolved_version"$'\n'
  maybe_interrupt_update current-version
  rc_atomic_write "$RC_INSTALL_ROOT/state/channel" "$requested_channel"$'\n'
  maybe_interrupt_update channel
  report_update_event installCompleted succeeded

  report_update_stage restarting
  report_update_event candidateRestartStarted started
  if rc_compose up -d reachcommander; then
    report_update_event candidateRestartCompleted succeeded
    if verify_running_image "$resolved_image"; then
      report_update_event candidateImageVerified succeeded
      report_update_stage healthChecking
      report_update_event candidateHealthStarted started
      if wait_for_update_health reachcommander 60 candidateHealthActivity; then
        report_update_event candidateHealthSucceeded succeeded
        rm -f -- "$marker"
        remove_update_backup "$backup_directory"
        printf 'ReachCommander updated successfully to %s (%s).\n' "$resolved_version" "$resolved_image"
        return 0
      fi
      report_update_event candidateHealthFailed failed
    else
      report_update_event candidateImageVerified failed
    fi
  else
    report_update_event candidateRestartCompleted failed
  fi

  report_update_stage restoring
  report_update_event rollbackStarted started
  rc_compose logs --tail 200 reachcommander >&2 || true
  rc_atomic_write "$RC_INSTALL_ROOT/state/failed-image" "$resolved_image"$'\n'
  if ! restore_update_backup "$backup_directory"; then
    report_update_event rollbackStateRestored failed
    printf 'ReachCommander: update failed and state restoration failed; manual recovery is required.\n' >&2
    return 3
  fi
  report_update_event rollbackStateRestored succeeded
  rm -f -- "$marker"
  remove_update_backup "$backup_directory" || true
  report_update_stage restartingPrevious
  report_update_event previousRestartStarted started
  if rc_compose up -d reachcommander; then
    report_update_stage verifyingRecovery
    report_update_event previousRestartCompleted succeeded
    if verify_running_image "$current_image"; then
      report_update_event previousImageVerified succeeded
      report_update_event recoveryHealthStarted started
      if wait_for_update_health reachcommander 60 recoveryHealthActivity; then
        report_update_event recoveryHealthSucceeded succeeded
        printf 'ReachCommander: update was unhealthy; the previous deployment was restored.\n' >&2
        return 2
      fi
      report_update_event recoveryHealthFailed failed
    else
      report_update_event previousImageVerified failed
    fi
  else
    report_update_event previousRestartCompleted failed
  fi
  printf 'ReachCommander: update and rollback were unhealthy; manual recovery is required.\n' >&2
  return 3
}

authentication_path_is_mount_point() {
  local path="$1"
  python3 - "$path" <<'PY'
import os
import sys

candidate = os.path.realpath(sys.argv[1])
try:
    with open('/proc/self/mountinfo', encoding='utf-8') as mounts:
        for line in mounts:
            fields = line.split()
            if len(fields) < 5:
                continue
            mount_path = fields[4]
            for escaped, value in ((r'\040', ' '), (r'\011', '\t'), (r'\012', '\n'), (r'\134', '\\')):
                mount_path = mount_path.replace(escaped, value)
            if os.path.realpath(mount_path) == candidate:
                raise SystemExit(0)
except FileNotFoundError:
    pass
raise SystemExit(1)
PY
}

application_data_tree_is_safe() {
  local data_root="$RC_INSTALL_ROOT/data"
  local path
  local relative_path
  if [[ ! -d "$data_root" || -L "$data_root" ]] || authentication_path_is_mount_point "$data_root"; then
    return 1
  fi
  while IFS= read -r -d '' path; do
    if [[ -L "$path" ]] || authentication_path_is_mount_point "$path"; then
      return 1
    fi
    relative_path="${path#"$data_root"/}"
    case "$relative_path" in
      auth | keys | file-operations | file-operations/plans | file-operations/operations)
        [[ -d "$path" ]] || return 1
        ;;
      auth/account.json | auth/bootstrap.json | auth/auth.lock | keys/key-*.xml)
        [[ -f "$path" ]] || return 1
        ;;
      *)
        if [[ "$relative_path" =~ ^file-operations/(plans|operations)/[0-9a-f]{32}\.json$ ]]; then
          [[ -f "$path" ]] || return 1
        else
          return 1
        fi
        ;;
    esac
  done < <(find "$data_root" -xdev -mindepth 1 -print0)
  [[ -d "$data_root/auth" && ! -L "$data_root/auth" ]] &&
    [[ -d "$data_root/keys" && ! -L "$data_root/keys" ]] &&
    {
      [[ ! -e "$data_root/file-operations" ]] ||
        {
          [[ -d "$data_root/file-operations" && ! -L "$data_root/file-operations" ]] &&
            [[ -d "$data_root/file-operations/plans" && ! -L "$data_root/file-operations/plans" ]] &&
            [[ -d "$data_root/file-operations/operations" && ! -L "$data_root/file-operations/operations" ]]
        }
    }
}

UNINSTALL_FILES=(
  '.env'
  'compose.yaml'
  'compose.override.yaml'
  'config/sources.json'
  'state/source-mounts.json'
  'state/channel'
  'state/current-image'
  'state/previous-image'
  'state/current-version'
  'state/previous-version'
  'state/source-operation.json'
  'state/source-runtime-operation.json'
  'state/command.lock'
  'bin/render_config.py'
  'bin/source_management.py'
  'bin/support_bundle_cli.py'
  'bin/update_trace_cli.py'
  'bin/updater_service.py'
  'lib/common.sh'
  'lib/compose.release.yaml'
  'lib/support_bundle.py'
  'lib/updater_protocol.py'
  'lib/updater_trace.py'
)

paths_overlap() {
  local first
  local second
  first="$(readlink -m -- "$1")"
  second="$(readlink -m -- "$2")"
  [[
    "$first" == "$second" ||
    "$first" == "$second"/* ||
    "$second" == "$first"/*
  ]]
}

validate_uninstall_tree() {
  local path
  local relative_path
  local invalid=0
  if [[ -L "$RC_INSTALL_ROOT" || -L "$RC_COMMAND_PATH" || -L "$RC_BACKUP_ROOT" ]]; then
    rc_die 'uninstall paths must not be symlinks'
    return 1
  fi
  if ! application_data_tree_is_safe; then
    rc_die 'application data tree contains an unsafe entry'
    return 1
  fi
  if ! run_update_trace_cli --doctor >/dev/null 2>&1; then
    rc_die 'update trace storage contains an unsafe entry'
    return 1
  fi
  while IFS= read -r -d '' path; do
    if [[ -L "$path" ]]; then
      invalid=1
      break
    fi
    relative_path="${path#"$RC_INSTALL_ROOT"/}"
    case "$relative_path" in
      config|state|state/update-traces|bin|lib|backups|data|data/auth|data/keys|\
      data/file-operations|data/file-operations/plans|data/file-operations/operations|\
      .env|compose.yaml|compose.override.yaml|\
      config/sources.json|\
      state/source-mounts.json|\
      state/channel|\
      state/current-image|\
      state/previous-image|\
      state/current-version|\
      state/previous-version|\
      state/source-operation.json|\
      state/source-runtime-operation.json|\
      state/failed-image|\
      state/system-update.json|\
      state/command.lock|\
      bin/render_config.py|\
      bin/source_management.py|\
      bin/support_bundle_cli.py|\
      bin/update_trace_cli.py|\
      bin/updater_service.py|\
      lib/common.sh|\
      lib/compose.release.yaml|\
      lib/support_bundle.py|\
      lib/updater_protocol.py|\
      lib/updater_trace.py)
        ;;
      data/auth/account.json|\
      data/auth/bootstrap.json|\
      data/auth/auth.lock|\
      data/keys/key-*.xml)
        [[ -f "$path" ]] || invalid=1
        ;;
      *)
        if [[ "$relative_path" =~ ^data/file-operations/(plans|operations)/[0-9a-f]{32}\.json$ ]] &&
          [[ -f "$path" ]]; then
          :
        elif [[ "$relative_path" == state/update-traces/*.jsonl ]] &&
          [[ -f "$path" ]]; then
          :
        else
          invalid=1
          break
        fi
        ;;
    esac
  done < <(find "$RC_INSTALL_ROOT" -mindepth 1 -print0)
  if (( invalid != 0 )); then
    rc_die 'install root contains an unexpected or symlinked entry'
    return 1
  fi
  if [[ ! -f "$RC_UPDATER_UNIT_PATH" || -L "$RC_UPDATER_UNIT_PATH" ]]; then
    rc_die 'updater systemd unit is missing or unsafe'
    return 1
  fi
}

load_uninstall_sources() {
  local source_output
  local source_path
  source_output="$(mktemp)"
  if ! python3 "$RC_INSTALL_ROOT/bin/render_config.py" source-paths \
    --sources "$RC_INSTALL_ROOT/state/source-mounts.json" \
    >"$source_output"; then
    rm -f -- "$source_output"
    rc_die 'source metadata is invalid; uninstall stopped'
    return 1
  fi
  UNINSTALL_SOURCE_PATHS=()
  while IFS= read -r -d '' source_path; do
    UNINSTALL_SOURCE_PATHS+=("$source_path")
  done <"$source_output"
  rm -f -- "$source_output"
  if (( ${#UNINSTALL_SOURCE_PATHS[@]} == 0 )); then
    rc_die 'source metadata contains no paths; uninstall stopped'
    return 1
  fi
}

validate_uninstall_separation() {
  local source_path
  local owned_path
  for source_path in "${UNINSTALL_SOURCE_PATHS[@]}"; do
    for owned_path in \
      "$RC_INSTALL_ROOT" \
      "$RC_COMMAND_PATH" \
      "$RC_BACKUP_ROOT" \
      "$RC_UPDATER_UNIT_PATH" \
      "$RC_UPDATER_RUNTIME_DIRECTORY"; do
      if paths_overlap "$source_path" "$owned_path"; then
        rc_die 'a configured source overlaps an uninstall target'
        return 1
      fi
    done
  done
}

backup_uninstall_file() {
  local relative_path="$1"
  local backup_destination="$2"
  local source="$RC_INSTALL_ROOT/$relative_path"
  local destination="$backup_destination/deployment/$relative_path"
  [[ -f "$source" && ! -L "$source" ]] || return 0
  mkdir -p -- "$(dirname -- "$destination")"
  if ! install -m 0600 -- "$source" "$destination" ||
    ! sync -f -- "$destination" ||
    ! cmp -s -- "$source" "$destination"; then
    rc_die 'external uninstall backup verification failed'
    return 1
  fi
}

create_uninstall_backup() {
  local backup_destination="$1"
  local relative_path
  if [[ -e "$RC_BACKUP_ROOT" && ! -d "$RC_BACKUP_ROOT" ]]; then
    rc_die 'external backup root is not a directory'
    return 1
  fi
  if [[ -L "$RC_BACKUP_ROOT" ]]; then
    rc_die 'external backup root must not be a symlink'
    return 1
  fi
  mkdir -p -- "$RC_BACKUP_ROOT"
  chmod 0700 -- "$RC_BACKUP_ROOT"
  if [[ -e "$backup_destination" ]]; then
    rc_die 'timestamped external backup already exists'
    return 1
  fi
  mkdir -p -- "$backup_destination/deployment"
  for relative_path in "${UNINSTALL_FILES[@]}"; do
    backup_uninstall_file "$relative_path" "$backup_destination" || return 1
  done
  if [[ -f "$RC_INSTALL_ROOT/state/failed-image" ]]; then
    backup_uninstall_file 'state/failed-image' "$backup_destination" || return 1
  fi
  if [[ -f "$RC_INSTALL_ROOT/state/system-update.json" ]]; then
    backup_uninstall_file 'state/system-update.json' "$backup_destination" || return 1
  fi
  backup_update_traces "$backup_destination" || return 1
  if ! install -m 0700 -- "$RC_COMMAND_PATH" "$backup_destination/reachcommander-command" ||
    ! sync -f -- "$backup_destination/reachcommander-command" ||
    ! cmp -s -- "$RC_COMMAND_PATH" "$backup_destination/reachcommander-command"; then
    rc_die 'management command backup verification failed'
    return 1
  fi
  if ! install -m 0644 -- \
    "$RC_UPDATER_UNIT_PATH" \
    "$backup_destination/reachcommander-updater.service" ||
    ! sync -f -- "$backup_destination/reachcommander-updater.service" ||
    ! cmp -s -- \
      "$RC_UPDATER_UNIT_PATH" \
      "$backup_destination/reachcommander-updater.service"; then
    rc_die 'updater unit backup verification failed'
    return 1
  fi
}

backup_application_file() {
  local relative_path="$1"
  local backup_destination="$2"
  local source="$RC_INSTALL_ROOT/data/$relative_path"
  local destination="$backup_destination/application-data/$relative_path"
  [[ -f "$source" && ! -L "$source" ]] || return 0
  mkdir -p -- "$(dirname -- "$destination")"
  if ! install -m 0600 -- "$source" "$destination" ||
    ! sync -f -- "$destination" ||
    ! cmp -s -- "$source" "$destination"; then
    rc_die 'application data backup verification failed'
    return 1
  fi
}

backup_update_traces() {
  local backup_destination="$1"
  local trace_path
  local destination
  if [[ ! -d "$RC_INSTALL_ROOT/state/update-traces" ]]; then
    return 0
  fi
  mkdir -p -- "$backup_destination/deployment/state/update-traces"
  chmod 0700 -- "$backup_destination/deployment/state/update-traces"
  while IFS= read -r -d '' trace_path; do
    destination="$backup_destination/deployment/state/update-traces/$(basename -- "$trace_path")"
    if ! install -m 0600 -- "$trace_path" "$destination" ||
      ! sync -f -- "$destination" ||
      ! cmp -s -- "$trace_path" "$destination"; then
      rc_die 'external update trace backup verification failed'
      return 1
    fi
  done < <(find "$RC_INSTALL_ROOT/state/update-traces" -mindepth 1 -maxdepth 1 -type f -print0)
}

backup_application_data() {
  local backup_destination="$1"
  local data_path
  local relative_path
  mkdir -p -- "$backup_destination/application-data"
  chmod 0700 -- "$backup_destination/application-data"
  while IFS= read -r -d '' data_path; do
    relative_path="${data_path#"$RC_INSTALL_ROOT/data"/}"
    mkdir -p -- "$backup_destination/application-data/$relative_path"
    chmod 0700 -- "$backup_destination/application-data/$relative_path"
  done < <(find "$RC_INSTALL_ROOT/data" -xdev -mindepth 1 -type d -print0)
  while IFS= read -r -d '' data_path; do
    relative_path="${data_path#"$RC_INSTALL_ROOT/data"/}"
    backup_application_file "$relative_path" "$backup_destination" || return 1
  done < <(find "$RC_INSTALL_ROOT/data" -xdev -mindepth 1 -type f -print0)
}

remove_application_data() {
  local data_path
  local relative_directory
  while IFS= read -r -d '' data_path; do
    rm -f -- "$data_path" || return 1
  done < <(find "$RC_INSTALL_ROOT/data" -xdev -mindepth 1 -type f -print0)
  for relative_directory in \
    file-operations/plans \
    file-operations/operations \
    file-operations \
    auth \
    keys; do
    if [[ -d "$RC_INSTALL_ROOT/data/$relative_directory" ]]; then
      rmdir -- "$RC_INSTALL_ROOT/data/$relative_directory" || return 1
    fi
  done
  rmdir -- "$RC_INSTALL_ROOT/data"
}

remove_update_traces() {
  local trace_path
  local trace_root="$RC_INSTALL_ROOT/state/update-traces"
  if [[ ! -d "$trace_root" ]]; then
    return 0
  fi
  while IFS= read -r -d '' trace_path; do
    rm -f -- "$trace_path" || return 1
  done < <(find "$trace_root" -mindepth 1 -maxdepth 1 -type f -print0)
  rmdir -- "$trace_root"
}

remove_generated_deployment() {
  local relative_path
  local directory
  for relative_path in "${UNINSTALL_FILES[@]}" 'state/failed-image' 'state/system-update.json'; do
    rm -f -- "$RC_INSTALL_ROOT/$relative_path" || return 1
  done
  remove_update_traces || return 1
  for directory in backups config state bin lib; do
    if [[ -d "$RC_INSTALL_ROOT/$directory" ]]; then
      rmdir -- "$RC_INSTALL_ROOT/$directory" || return 1
    fi
  done
}

restart_uninstall_service() {
  if systemctl daemon-reload &&
    systemctl enable --now reachcommander-updater.service &&
    rc_compose up -d reachcommander &&
    rc_wait_healthy reachcommander 60; then
    printf 'ReachCommander: the previous service was restarted after uninstall stopped.\n' >&2
    return 0
  fi
  printf 'ReachCommander: uninstall stopped and automatic service restart failed; manual recovery is required.\n' >&2
  return 1
}

stop_updater_service() {
  if ! systemctl disable --now reachcommander-updater.service; then
    rc_die 'updater service could not be stopped'
    return 1
  fi
}

remove_updater_service_files() {
  rm -f -- "$RC_UPDATER_UNIT_PATH" "$RC_UPDATER_SOCKET_PATH" || return 1
  systemctl daemon-reload || return 1
  if [[ -d "$RC_UPDATER_RUNTIME_DIRECTORY" && ! -L "$RC_UPDATER_RUNTIME_DIRECTORY" ]]; then
    rmdir -- "$RC_UPDATER_RUNTIME_DIRECTORY" 2>/dev/null || true
  fi
}

command_uninstall() {
  local timestamp=''
  local backup_destination=''
  local application_action
  local confirmation
  local source_path
  if ! rc_acquire_lock; then
    return 1
  fi
  if [[ -e "$RC_INSTALL_ROOT/state/update-transaction" ]]; then
    rc_die 'an incomplete update transaction must be resolved before uninstall'
    return 1
  fi
  if [[ -e "$RC_INSTALL_ROOT/state/install-transaction" ]]; then
    rc_die 'an incomplete reconfiguration must be recovered by rerunning the installer before uninstall'
    return 1
  fi
  validate_uninstall_tree || return 1
  load_uninstall_sources || return 1
  validate_uninstall_separation || return 1

  printf 'ReachCommander uninstall will remove:\n'
  printf '  container/network: reachcommander\n'
  printf '  management command: %s\n' "$RC_COMMAND_PATH"
  printf '  generated deployment files: %s\n' "$RC_INSTALL_ROOT"
  printf 'Configured source directories are excluded and will not be changed:\n'
  for source_path in "${UNINSTALL_SOURCE_PATHS[@]}"; do
    printf '  %s\n' "$source_path"
  done
  printf 'Application data action (retain or backup) [retain]: ' >&2
  if ! IFS= read -r application_action; then
    rc_die 'uninstall cancelled; application data action was not provided'
    return 1
  fi
  application_action="${application_action:-retain}"
  if [[ "$application_action" != 'retain' && "$application_action" != 'backup' ]]; then
    rc_die 'uninstall cancelled; application data action must be retain or backup'
    return 1
  fi
  if [[ "$application_action" == 'backup' ]]; then
    timestamp="$(date -u +%Y%m%dT%H%M%SZ)"
    if [[ ! "$timestamp" =~ ^[0-9]{8}T[0-9]{6}Z$ ]]; then
      rc_die 'UTC backup timestamp is invalid'
      return 1
    fi
    backup_destination="$RC_BACKUP_ROOT/$timestamp"
    printf '  verified backup destination: %s\n' "$backup_destination"
  else
    printf '  application data retained at: %s\n' "$RC_INSTALL_ROOT/data"
  fi
  printf "Type 'uninstall ReachCommander' to continue: " >&2
  if ! IFS= read -r confirmation || [[ "$confirmation" != 'uninstall ReachCommander' ]]; then
    rc_die 'uninstall cancelled; confirmation did not match'
    return 1
  fi

  if ! rc_compose stop reachcommander; then
    rc_die 'Compose stop failed; deployment and command were preserved'
    return 1
  fi
  if ! validate_uninstall_tree; then
    restart_uninstall_service || true
    return 1
  fi
  if [[ "$application_action" == 'backup' ]]; then
    if ! create_uninstall_backup "$backup_destination" ||
      ! backup_application_data "$backup_destination"; then
      restart_uninstall_service || true
      return 1
    fi
  fi
  if ! stop_updater_service; then
    restart_uninstall_service || true
    return 1
  fi
  if ! rc_compose down; then
    restart_uninstall_service || true
    rc_die 'Compose teardown failed; deployment and command were preserved'
    return 1
  fi
  if ! remove_updater_service_files; then
    rc_die 'updater service files could not be removed'
    return 1
  fi
  if [[ "$application_action" == 'backup' ]] && ! remove_application_data; then
    rc_die "application data removal was incomplete; verified backup is at $backup_destination"
    return 1
  fi
  if ! remove_generated_deployment; then
    if [[ "$application_action" == 'backup' ]]; then
      rc_die "generated deployment removal was incomplete; verified backup is at $backup_destination"
    else
      rc_die "generated deployment removal was incomplete; application data remains at $RC_INSTALL_ROOT/data"
    fi
    return 1
  fi
  if [[ "$application_action" == 'backup' ]] && ! rmdir -- "$RC_INSTALL_ROOT"; then
    rc_die "install root removal was incomplete; verified backup is at $backup_destination"
    return 1
  fi
  if ! rm -f -- "$RC_COMMAND_PATH"; then
    if [[ "$application_action" == 'backup' ]]; then
      rc_die "management command removal failed; verified backup is at $backup_destination"
    else
      rc_die "management command removal failed; application data remains at $RC_INSTALL_ROOT/data"
    fi
    return 1
  fi
  if [[ "$application_action" == 'backup' ]]; then
    printf 'ReachCommander was uninstalled. Verified backup: %s\n' "$backup_destination"
  else
    printf 'ReachCommander was uninstalled. Application data retained at: %s\n' "$RC_INSTALL_ROOT/data"
  fi
}

DOCTOR_FAILURES=0

doctor_pass() {
  printf '[PASS] %s\n' "$1"
}

doctor_warn() {
  printf '[WARN] %s\n' "$1"
}

doctor_fail() {
  DOCTOR_FAILURES=$((DOCTOR_FAILURES + 1))
  printf '[FAIL] %s\n' "$1"
}

doctor_source_transaction_state() {
  local source_helper="$RC_INSTALL_ROOT/bin/source_management.py"
  local source_state=''
  if ! source_management_dependencies_are_safe; then
    doctor_fail 'Source transaction state cannot be validated because its helper is unavailable or unsafe'
    return
  fi
  if ! source_state="$(
    PYTHONDONTWRITEBYTECODE=1 python3 "$source_helper" --doctor-state 2>/dev/null
  )"; then
    doctor_fail 'Source transaction state is invalid; reinstall or restore the installer-managed state'
    return
  fi
  case "$source_state" in
    clear)
      doctor_pass 'No source operation journal or recovery transaction is present'
      ;;
    journal)
      doctor_warn 'Source operation journal is present; no recovery transaction is pending'
      ;;
    recovery-required)
      doctor_fail 'Source transaction recovery is required; retry the original source add, then reinstall if recovery still fails'
      ;;
    recovery-unavailable)
      doctor_fail 'Source transaction recovery data is missing or invalid; restore a verified backup manually or reinstall ReachCommander'
      ;;
    *)
      doctor_fail 'Source transaction state returned an invalid diagnostic result'
      ;;
  esac
}

read_env_value() {
  local key="$1"
  local line
  local count
  line="$(grep -E "^${key}=" "$RC_INSTALL_ROOT/.env" || true)"
  count="$(printf '%s\n' "$line" | grep -c . || true)"
  if [[ "$count" != '1' ]]; then
    return 1
  fi
  printf '%s\n' "${line#*=}"
}

doctor_required_files() {
  local required
  local missing=0
  for required in \
    '.env' \
    'compose.yaml' \
    'compose.override.yaml' \
    'config/sources.json' \
    'state/source-mounts.json' \
    'state/channel' \
    'state/current-image' \
    'state/previous-image' \
    'state/current-version' \
    'state/previous-version' \
    'bin/render_config.py' \
    'bin/source_management.py' \
    'bin/support_bundle_cli.py' \
    'bin/updater_service.py' \
    'bin/update_trace_cli.py' \
    'lib/common.sh' \
    'lib/compose.release.yaml' \
    'lib/support_bundle.py' \
    'lib/updater_protocol.py' \
    'lib/updater_trace.py'; do
    if [[ ! -f "$RC_INSTALL_ROOT/$required" || -L "$RC_INSTALL_ROOT/$required" ]]; then
      missing=1
      doctor_fail "Required deployment file is missing or symlinked: $required"
    fi
  done
  if (( missing == 0 )); then
    doctor_pass 'Required deployment files are present'
  fi
  if [[ -x "$RC_COMMAND_PATH" && ! -L "$RC_COMMAND_PATH" ]]; then
    doctor_pass 'Management command is installed at the fixed path'
  else
    doctor_fail 'Management command is missing, symlinked, or not executable'
  fi
  if [[ -f "$RC_UPDATER_UNIT_PATH" && ! -L "$RC_UPDATER_UNIT_PATH" ]]; then
    doctor_pass 'Updater systemd unit is installed at the fixed path'
  else
    doctor_fail 'Updater systemd unit is missing or symlinked'
  fi
}

doctor_sources() {
  local source_output
  local source_path
  local runtime_uid="$1"
  local runtime_gid="$2"
  source_output="$(mktemp)"
  if ! python3 "$RC_INSTALL_ROOT/bin/render_config.py" source-paths \
    --sources "$RC_INSTALL_ROOT/state/source-mounts.json" \
    >"$source_output"; then
    rm -f -- "$source_output"
    doctor_fail 'Installer source metadata is invalid'
    return
  fi
  while IFS= read -r -d '' source_path; do
    if [[ ! -d "$source_path" ]]; then
      doctor_fail 'Source path is missing'
      continue
    fi
    if command -v setpriv >/dev/null 2>&1 && setpriv \
      --reuid="$runtime_uid" \
      --regid="$runtime_gid" \
      --clear-groups \
      -- sh -c "test -r \"\$1\" && test -x \"\$1\"" reachcommander-doctor "$source_path"; then
      doctor_pass 'Source path is accessible'
    else
      doctor_fail 'Source path is not accessible to the runtime identity'
    fi
  done <"$source_output"
  rm -f -- "$source_output"
}

doctor_application_data() {
  local runtime_uid="$1"
  local runtime_gid="$2"
  local path
  local owner
  local mode
  local relative_path
  local container_path
  local -a data_directories=(data data/auth data/keys)
  if ! application_data_tree_is_safe; then
    doctor_fail 'Application data tree contains an unsafe entry'
    return
  fi
  doctor_pass 'Application data tree is structurally safe'

  if [[ -d "$RC_INSTALL_ROOT/data/file-operations" ]]; then
    data_directories+=(
      data/file-operations
      data/file-operations/plans
      data/file-operations/operations
    )
  fi

  for relative_path in "${data_directories[@]}"; do
    path="$RC_INSTALL_ROOT/$relative_path"
    owner="$(stat -c '%u:%g' -- "$path" 2>/dev/null || true)"
    mode="$(stat -c '%a' -- "$path" 2>/dev/null || true)"
    if [[ "$owner" == "$runtime_uid:$runtime_gid" && "$mode" == '700' ]]; then
      doctor_pass 'Application data directory ownership and mode are correct'
    else
      doctor_fail 'Application data directory ownership or mode is incorrect'
    fi
    container_path="/$relative_path"
    if docker exec \
      --user "$runtime_uid:$runtime_gid" \
      reachcommander \
      sh -c 'test -r "$1" && test -w "$1" && test -x "$1"' \
      reachcommander-doctor \
      "$container_path" >/dev/null 2>&1; then
      doctor_pass 'Application data directory is accessible to the runtime identity'
    else
      doctor_fail 'Application data directory is not accessible to the runtime identity'
    fi
  done

  while IFS= read -r -d '' path; do
    owner="$(stat -c '%u:%g' -- "$path" 2>/dev/null || true)"
    mode="$(stat -c '%a' -- "$path" 2>/dev/null || true)"
    if [[ "$owner" == "$runtime_uid:$runtime_gid" && "$mode" == '600' ]]; then
      doctor_pass 'Application data file ownership and mode are correct'
    else
      doctor_fail 'Application data file ownership or mode is incorrect'
    fi
  done < <(find "$RC_INSTALL_ROOT/data" -xdev -mindepth 2 -type f -print0)

  if [[ -f "$RC_INSTALL_ROOT/data/auth/account.json" ]]; then
    if python3 -m json.tool "$RC_INSTALL_ROOT/data/auth/account.json" >/dev/null 2>&1; then
      doctor_pass 'Administrator account state is valid JSON'
    else
      doctor_fail 'Administrator account state is invalid JSON'
    fi
  else
    doctor_warn 'Administrator account is not configured; first-run setup mode is active'
  fi
  if [[ -f "$RC_INSTALL_ROOT/data/auth/bootstrap.json" ]]; then
    if python3 -m json.tool "$RC_INSTALL_ROOT/data/auth/bootstrap.json" >/dev/null 2>&1; then
      doctor_pass 'First-run setup state is valid JSON'
    else
      doctor_fail 'First-run setup state is invalid JSON'
    fi
  fi
}

command_doctor() {
  local access_mode=''
  local bind_address=''
  local allow_insecure_http=''
  local port=''
  local runtime_uid=''
  local runtime_gid=''
  local environment_image=''
  local current_image=''
  local current_version=''
  local previous_version=''
  local channel=''
  local health=''
  DOCTOR_FAILURES=0

  if command -v docker >/dev/null 2>&1; then
    doctor_pass 'Docker Engine is available'
  else
    doctor_fail 'Docker Engine is unavailable'
  fi
  if docker compose version >/dev/null 2>&1; then
    doctor_pass 'Docker Compose v2 is available'
  else
    doctor_fail 'Docker Compose v2 is unavailable'
  fi

  doctor_required_files

  local trace_detail=''
  if trace_detail="$(run_update_trace_cli --doctor 2>/dev/null)"; then
    doctor_pass "$trace_detail"
  else
    doctor_fail "${trace_detail:-Update trace storage could not be validated}"
  fi

  if [[ -e "$RC_INSTALL_ROOT/state/update-transaction" ]]; then
    doctor_fail 'Incomplete update transaction requires manual review'
  else
    doctor_pass 'No incomplete update transaction is present'
  fi
  if [[ -e "$RC_INSTALL_ROOT/state/install-transaction" ]]; then
    doctor_fail 'Incomplete reconfiguration transaction requires installer recovery'
  else
    doctor_pass 'No incomplete reconfiguration transaction is present'
  fi
  doctor_source_transaction_state

  if python3 -m json.tool "$RC_INSTALL_ROOT/config/sources.json" >/dev/null 2>&1; then
    doctor_pass 'Application source configuration is valid JSON'
  else
    doctor_fail 'Application source configuration is invalid JSON'
  fi

  if rc_compose config --quiet >/dev/null 2>&1; then
    doctor_pass 'Compose configuration is valid'
  else
    doctor_fail 'Compose configuration is invalid'
  fi

  if access_mode="$(read_env_value REACHCOMMANDER_ACCESS_MODE)" &&
    bind_address="$(read_env_value REACHCOMMANDER_BIND_ADDRESS)" &&
    allow_insecure_http="$(read_env_value REACHCOMMANDER_ALLOW_INSECURE_HTTP)"; then
    case "$access_mode:$bind_address:$allow_insecure_http" in
      'secure-https:127.0.0.1:false')
        doctor_pass 'Secure HTTPS upstream is loopback-only'
        ;;
      'trusted-lan-http:0.0.0.0:true')
        doctor_warn 'Trusted LAN HTTP listens on every host interface'
        ;;
      *)
        doctor_fail 'Network access policy is inconsistent'
        ;;
    esac
  else
    doctor_fail 'Network access policy is missing or duplicated'
  fi

  if port="$(read_env_value REACHCOMMANDER_PORT)" && rc_validate_port "$port" >/dev/null 2>&1; then
    doctor_pass 'Host port is valid'
  else
    doctor_fail 'Host port is invalid'
  fi

  if runtime_uid="$(read_env_value REACHCOMMANDER_UID)" &&
    runtime_gid="$(read_env_value REACHCOMMANDER_GID)" &&
    [[ "$runtime_uid" =~ ^[1-9][0-9]*$ ]] &&
    [[ "$runtime_gid" =~ ^[1-9][0-9]*$ ]]; then
    doctor_pass 'Runtime UID and GID are non-root'
    doctor_sources "$runtime_uid" "$runtime_gid"
    doctor_application_data "$runtime_uid" "$runtime_gid"
  else
    doctor_fail 'Runtime UID or GID is invalid'
  fi

  if channel="$(read_state_line "$RC_INSTALL_ROOT/state/channel" 2>/dev/null)" &&
    rc_validate_channel "$channel" >/dev/null 2>&1; then
    doctor_pass 'Update channel is valid'
  else
    doctor_fail 'Update channel is invalid'
  fi

  if environment_image="$(read_env_value REACHCOMMANDER_IMAGE)" &&
    current_image="$(read_state_line "$RC_INSTALL_ROOT/state/current-image" 2>/dev/null)"; then
    if [[ "$environment_image" == "$current_image" ]]; then
      doctor_pass 'Environment image matches current-image state'
    else
      doctor_fail 'Environment image does not match current-image state'
    fi
  else
    doctor_fail 'Immutable image state is missing'
  fi

  if current_version="$(read_state_line "$RC_INSTALL_ROOT/state/current-version" 2>/dev/null)" &&
    rc_validate_display_version "$current_version" >/dev/null 2>&1; then
    doctor_pass 'Current display version state is valid'
  else
    doctor_fail 'Current display version state is invalid'
  fi
  if [[ ! -s "$RC_INSTALL_ROOT/state/previous-version" ]]; then
    doctor_pass 'Previous display version state is valid'
  elif previous_version="$(read_state_line "$RC_INSTALL_ROOT/state/previous-version" 2>/dev/null)" &&
    rc_validate_display_version "$previous_version" >/dev/null 2>&1; then
    doctor_pass 'Previous display version state is valid'
  else
    doctor_fail 'Previous display version state is invalid'
  fi

  if health="$(
    docker inspect \
      --format '{{if .State.Health}}{{.State.Health.Status}}{{else}}missing{{end}}' \
      reachcommander 2>/dev/null
  )" && [[ "$health" == 'healthy' ]]; then
    doctor_pass 'Container is healthy'
  else
    doctor_fail 'Container is not healthy'
  fi

  if systemctl is-active --quiet reachcommander-updater.service; then
    doctor_pass 'Updater service is active'
  else
    doctor_fail 'Updater service is not active'
  fi
  if [[ "${REACHCOMMANDER_TESTING:-0}" == '1' ]] && (( EUID != 0 )); then
    if [[ -f "$RC_UPDATER_SOCKET_PATH" && ! -L "$RC_UPDATER_SOCKET_PATH" ]]; then
      doctor_pass 'Updater socket is ready'
    else
      doctor_fail 'Updater socket is unavailable'
    fi
  elif [[ -S "$RC_UPDATER_SOCKET_PATH" ]]; then
    doctor_pass 'Updater socket is ready'
  else
    doctor_fail 'Updater socket is unavailable'
  fi

  if (( DOCTOR_FAILURES > 0 )); then
    return 1
  fi
}

case "$1" in
  status)
    command_status
    ;;
  logs)
    command_logs "${2:-}"
    ;;
  update-log)
    command_update_log "${2:-}"
    ;;
  support-bundle)
    command_support_bundle
    ;;
  start)
    command_start
    ;;
  stop)
    command_stop
    ;;
  restart)
    command_restart
    ;;
  doctor)
    command_doctor
    ;;
  source)
    command_source_add
    ;;
  update)
    command_update "${2:-}"
    ;;
  uninstall)
    command_uninstall
    ;;
esac
