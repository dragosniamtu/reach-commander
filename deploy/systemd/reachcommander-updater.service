[Unit]
Description=ReachCommander restricted system updater
Documentation=https://github.com/dragosniamtu/reach-commander
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
User=root
Group=root
UMask=0007
ExecStart=/usr/bin/python3 /opt/reachcommander/bin/updater_service.py
Restart=on-failure
RestartSec=5s
TimeoutStopSec=15s
RuntimeDirectory=reachcommander-updater
RuntimeDirectoryMode=0750
Environment=PYTHONDONTWRITEBYTECODE=1
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectHostname=yes
ProtectClock=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
ReadWritePaths=/opt/reachcommander /opt/.reachcommander.lock /run/reachcommander-updater

[Install]
WantedBy=multi-user.target
