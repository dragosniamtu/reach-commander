# ReachCommander Caddy example.
# Optional defense in depth: remove the complete basic_auth block when
# ReachCommander's built-in login is the only authentication layer.
# If kept, set REACHCOMMANDER_PASSWORD_HASH to output from `caddy hash-password`.
# Never commit the hash or plaintext password.

reachcommander.example.com {
    request_body {
        max_size 50GB
    }

    # Optional; this complete block may be removed.
    basic_auth {
        admin {$REACHCOMMANDER_PASSWORD_HASH}
    }

    reverse_proxy 127.0.0.1:8092 {
        transport http {
            dial_timeout 30s
            response_header_timeout 6h
        }
    }
}
