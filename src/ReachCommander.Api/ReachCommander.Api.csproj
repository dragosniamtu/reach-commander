<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AngularProjectDirectory>$(MSBuildProjectDirectory)\..\..\client\reach-commander-ui</AngularProjectDirectory>
    <BuildAngularOnPublish Condition="'$(BuildAngularOnPublish)' == ''">true</BuildAngularOnPublish>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ReachCommander.Application\ReachCommander.Application.csproj" />
    <ProjectReference Include="..\ReachCommander.Infrastructure\ReachCommander.Infrastructure.csproj" />
    <ProjectReference Include="..\ReachCommander.ArchiveWorker\ReachCommander.ArchiveWorker.csproj"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <Target Name="BuildAngularForPublish" BeforeTargets="ComputeFilesToPublish"
          Condition="'$(BuildAngularOnPublish)' == 'true'">
    <Exec Command="npm ci" WorkingDirectory="$(AngularProjectDirectory)" />
    <Exec Command="npm run build" WorkingDirectory="$(AngularProjectDirectory)" />
  </Target>

  <Target Name="CopyAngularAssets" AfterTargets="ComputeFilesToPublish"
          Condition="Exists('$(AngularProjectDirectory)\dist\reach-commander-ui\browser')">
    <ItemGroup>
      <ClientAsset Include="$(AngularProjectDirectory)\dist\reach-commander-ui\browser\**\*" />
      <ResolvedFileToPublish Include="@(ClientAsset)" Exclude="@(ResolvedFileToPublish)">
        <RelativePath>wwwroot\%(RecursiveDir)%(Filename)%(Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

  <Target Name="CopyArchiveWorkerBuildOutput" AfterTargets="Build">
    <ItemGroup>
      <ArchiveWorkerBuildOutput Include="..\ReachCommander.ArchiveWorker\bin\$(Configuration)\$(TargetFramework)\**\*"
                                Exclude="..\ReachCommander.ArchiveWorker\bin\$(Configuration)\$(TargetFramework)\publish\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(ArchiveWorkerBuildOutput)"
          DestinationFolder="$(TargetDir)archive-worker\%(RecursiveDir)"
          SkipUnchangedFiles="true" />
  </Target>

  <Target Name="PublishArchiveWorker" AfterTargets="Publish">
    <MSBuild Projects="..\ReachCommander.ArchiveWorker\ReachCommander.ArchiveWorker.csproj"
             Targets="Publish"
             Properties="Configuration=$(Configuration);TargetFramework=$(TargetFramework);PublishDir=$(PublishDir)archive-worker\;SelfContained=false" />
  </Target>

</Project>
