<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ReachCommander.Application\ReachCommander.Application.csproj" />
    <ProjectReference Include="..\ReachCommander.Infrastructure\ReachCommander.Infrastructure.csproj" />
  </ItemGroup>

  <Target Name="CopyAngularAssets" AfterTargets="ComputeFilesToPublish"
          Condition="Exists('$(MSBuildProjectDirectory)\..\..\client\reach-commander-ui\dist\reach-commander-ui\browser')">
    <ItemGroup>
      <ClientAsset Include="$(MSBuildProjectDirectory)\..\..\client\reach-commander-ui\dist\reach-commander-ui\browser\**\*" />
      <ResolvedFileToPublish Include="@(ClientAsset)" Exclude="@(ResolvedFileToPublish)">
        <RelativePath>wwwroot\%(RecursiveDir)%(Filename)%(Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

</Project>
