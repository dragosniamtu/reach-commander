#!/usr/bin/env bash
set -Eeuo pipefail

if [[ -n "${FAKE_DOCKER_LOG:-}" ]]; then
  printf '%s\0' "$@" >>"$FAKE_DOCKER_LOG"
  printf '\0' >>"$FAKE_DOCKER_LOG"
fi

if [[ "${FAKE_DOCKER_PRINT_ARGS:-0}" == "1" ]]; then
  printf '[%s]\n' "$@"
fi

read_sequence_value() {
  local sequence_file="$1"
  local value
  IFS= read -r value <"$sequence_file"
  tail -n +2 "$sequence_file" >"${sequence_file}.next"
  mv -f "${sequence_file}.next" "$sequence_file"
  printf '%s\n' "$value"
}

case "${1:-}" in
  compose)
    if [[ "${2:-}" == 'version' ]]; then
      exit "${FAKE_DOCKER_VERSION_EXIT:-0}"
    fi
    for argument in "$@"; do
      if [[ "$argument" == 'config' ]]; then
        exit "${FAKE_DOCKER_CONFIG_EXIT:-${FAKE_DOCKER_COMPOSE_EXIT:-0}}"
      fi
    done
    if [[ -n "${FAKE_DOCKER_COMPOSE_SEQUENCE_FILE:-}" && -s "$FAKE_DOCKER_COMPOSE_SEQUENCE_FILE" ]]; then
      compose_status="$(read_sequence_value "$FAKE_DOCKER_COMPOSE_SEQUENCE_FILE")"
      exit "$compose_status"
    fi
    exit "${FAKE_DOCKER_COMPOSE_EXIT:-0}"
    ;;
  pull)
    exit "${FAKE_DOCKER_PULL_EXIT:-0}"
    ;;
  image)
    if [[ "${2:-}" != "inspect" ]]; then
      printf 'fake docker: unsupported image command\n' >&2
      exit 97
    fi
    case "${4:-}" in
      '{{.Id}}')
        image_id="${FAKE_DOCKER_IMAGE_ID:-${5##*@}}"
        printf '%s\n' "$image_id"
        ;;
      *org.opencontainers.image.version*)
        printf '%s\n' "${FAKE_DOCKER_VERSION_LABEL:-}"
        ;;
      *org.opencontainers.image.revision*)
        printf '%s\n' "${FAKE_DOCKER_REVISION_LABEL:-}"
        ;;
      *)
        printf '%s\n' "${FAKE_DOCKER_DIGESTS:-}"
        ;;
    esac
    exit "${FAKE_DOCKER_INSPECT_EXIT:-0}"
    ;;
  inspect)
    if [[ "${3:-}" == '{{.Image}}' ]]; then
      if [[ -n "${FAKE_DOCKER_RUNNING_IMAGE_ID_FILE:-}" && -s "$FAKE_DOCKER_RUNNING_IMAGE_ID_FILE" ]]; then
        read_sequence_value "$FAKE_DOCKER_RUNNING_IMAGE_ID_FILE"
      elif [[ -n "${FAKE_DOCKER_RUNNING_IMAGE_ID:-}" ]]; then
        printf '%s\n' "$FAKE_DOCKER_RUNNING_IMAGE_ID"
      else
        configured_image="$(
          sed -n 's/^REACHCOMMANDER_IMAGE=//p' \
            "$REACHCOMMANDER_TEST_INSTALL_ROOT/.env"
        )"
        printf '%s\n' "${configured_image##*@}"
      fi
      exit "${FAKE_DOCKER_INSPECT_EXIT:-0}"
    fi
    if [[ -n "${FAKE_DOCKER_HEALTH_FILE:-}" && -s "$FAKE_DOCKER_HEALTH_FILE" ]]; then
      read_sequence_value "$FAKE_DOCKER_HEALTH_FILE"
    else
      printf '%s\n' "${FAKE_DOCKER_HEALTH:-healthy}"
    fi
    exit "${FAKE_DOCKER_INSPECT_EXIT:-0}"
    ;;
  exec)
    if [[ -n "${FAKE_DOCKER_EXEC_DENY_PREFIX:-}" ]]; then
      for argument in "$@"; do
        if [[ "$argument" == "$FAKE_DOCKER_EXEC_DENY_PREFIX" || "$argument" == "$FAKE_DOCKER_EXEC_DENY_PREFIX/"* ]]; then
          exit 98
        fi
      done
    fi
    exit "${FAKE_DOCKER_EXEC_EXIT:-0}"
    ;;
  *)
    printf 'fake docker: unsupported invocation\n' >&2
    exit 97
    ;;
esac
